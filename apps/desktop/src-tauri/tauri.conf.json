{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustique",
  "version": "0.1.0",
  "identifier": "studio.rustique.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rustique", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
