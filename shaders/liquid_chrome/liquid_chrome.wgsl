struct Params { resolution: vec2<f32>, time: f32, roughness: f32, reflection: f32, metallic: f32, surface_scale: f32, surface_deformation: f32, base_color: vec3<f32>, vertical_fov_degrees: f32 }
@group(0) @binding(0) var environment: texture_2d<f32>;
@group(0) @binding(1) var environment_sampler: sampler;
@group(0) @binding(2) var<uniform> params: Params;
struct Out { @builtin(position) position: vec4<f32>, @location(0) uv: vec2<f32> }
@vertex fn vs_main(@builtin(vertex_index) i:u32)->Out { let p=array<vec2<f32>,3>(vec2(-1,-1),vec2(3,-1),vec2(-1,3)); var o:Out; o.position=vec4(p[i],0,1); o.uv=p[i]*vec2(.5,-.5)+.5; return o; }
fn sd_sphere(p:vec3<f32>,c:vec3<f32>,r:f32)->f32{return length(p-c)-r;}
fn smooth_min(a:f32,b:f32,k:f32)->f32{let h=clamp(.5+.5*(b-a)/k,0.,1.);return mix(b,a,h)-k*h*(1.-h);}
fn scene(p:vec3<f32>)->f32 { let t=params.time; let s=params.surface_scale; var d=sd_sphere(p,vec3(0.,.02*sin(t*.7),0.),.62*s); d=smooth_min(d,sd_sphere(p,vec3(.48*sin(t*.53),.34*cos(t*.71),.12*sin(t)),.38*s),.28); d=smooth_min(d,sd_sphere(p,vec3(-.43*cos(t*.47),-.31*sin(t*.83),.18*cos(t)),.34*s),.25); let warp=sin(p.x*7.+t*.8)*sin(p.y*6.-t*.55)*sin(p.z*8.+t*.35); return d+warp*params.surface_deformation; }
fn normal(p:vec3<f32>)->vec3<f32>{let e=.002;return normalize(vec3(scene(p+vec3(e,0,0))-scene(p-vec3(e,0,0)),scene(p+vec3(0,e,0))-scene(p-vec3(0,e,0)),scene(p+vec3(0,0,e))-scene(p-vec3(0,0,e))));}
fn env(d:vec3<f32>)->vec3<f32>{let uv=vec2(atan2(d.z,d.x)/6.2831853+.5,acos(clamp(d.y,-1.,1.))/3.1415927);return textureSample(environment,environment_sampler,uv).rgb;}
@fragment fn fs_main(i:Out)->@location(0) vec4<f32>{let q=(i.uv*2.-1.)*vec2(params.resolution.x/params.resolution.y,1.);let ro=vec3(0.,0.,2.65);let tan_half_fov=tan(params.vertical_fov_degrees*.00872664626);let rd=normalize(vec3(q*tan_half_fov,-1.));var depth=0.;var hit=false;for(var step=0;step<112;step++){let p=ro+rd*depth;let d=scene(p);if(d<.0015){hit=true;break;}depth+=max(d*.65,.001);if(depth>6.){break;}}if(!hit){let studio=vec3(.006,.008,.012)*(1.2-.35*i.uv.y);return vec4(mix(studio,env(rd)*.18,params.metallic),1.);}let p=ro+rd*depth;let n=normal(p);let reflected=reflect(rd,n);let blurred=normalize(mix(reflected,n,params.roughness*.55));let environment_color=env(blurred)*params.reflection;let view_fresnel=pow(1.-max(dot(-rd,n),0.),5.);let dielectric_fresnel=.04+.96*view_fresnel;let light=normalize(vec3(-.4,.8,.5));let diffuse=params.base_color*(.16+.84*max(dot(n,light),0.));let highlight=vec3(1.)*pow(max(dot(reflect(-light,n),-rd),0.),48.*(1.-params.roughness)+2.);let wet=diffuse+environment_color*dielectric_fresnel+highlight*.8;let metal=environment_color*(.55+.45*view_fresnel)+highlight*.7;return vec4(mix(wet,metal,params.metallic),1.);}
